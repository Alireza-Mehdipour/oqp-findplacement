# Copy this file to .env for local development, or set these as
# environment variables in your hosting provider (e.g. Vercel).
# NEVER commit a real .env file — .gitignore excludes it.

# Your Anthropic API key from https://console.anthropic.com
# Stays server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# A shared password you invent, required to run a search.
# Prevents strangers from spending your API credits.
APP_PASSWORD=choose-a-password
